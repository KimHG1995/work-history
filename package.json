{
  "name": "work-history",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "node scripts/prepare-site.mjs && node scripts/prepare-chat.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev site",
    "docs:build": "npm run docs:prepare && vitepress build site && node scripts/secure-site.mjs",
    "docs:preview": "vitepress preview site --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "chat:deploy": "node scripts/deploy-chat.mjs",
    "test:worker": "wrangler deploy --dry-run --outdir .wrangler/test-build && node --test tests/worker.integration.mjs",
    "test:mermaid": "node scripts/validate-mermaid.mjs"
  },
  "devDependencies": {
    "mermaid": "^11.0.0",
    "vitepress": "1.6.4",
    "wrangler": "4.133.0"
  }
}
